# Скопируйте этот файл в .env и заполните реальными значениями.
# Файл .env никогда не публикуется и не попадает в чат — только на сервер.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Данные от Nodul (или другого прокси-сервиса к Claude API)
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=

# Username бота без @, для проверки упоминания в группах (topolya_mark_bot)
BOT_USERNAME=topolya_mark_bot
