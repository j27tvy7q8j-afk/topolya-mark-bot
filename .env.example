# Скопировать в .env и заполнить на сервере. Значения секретов в репозиторий не попадают.
TELEGRAM_BOT_TOKEN=
BOT_USERNAME=topolya_mark_bot
NOTION_TOKEN=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
GOOGLE_SA_FILE=google-sa.json
DOCS_DB_ID=
STAFF_DB_ID=
JOURNAL_DB_ID=
GAPS_DB_ID=
# Куда слать тревоги (Telegram ID владельца), необязательно:
OWNER_TELEGRAM_ID=
# Модели (меняются одной строкой):
SELECT_MODEL=aliceai-llm-flash
ANSWER_MODEL=aliceai-llm
# Внешний мониторинг «бот жив» (адрес пинга из healthchecks.io), необязательно:
HEALTHCHECK_URL=
# Рассылки с кнопкой «Ознакомился» и мини-тесты (ID баз из «Служебные базы»):
ACK_DB_ID=
QUIZ_DB_ID=
# 1 — тест раз в неделю по понедельникам в 11:00 (МСК); 0 — только вручную (/quiz_now):
QUIZ_WEEKLY=0
